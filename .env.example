# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/medread"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-another-long-random-string"

# --- Anonymous "try before you sign up" ---
IP_HASH_SALT="replace-with-a-long-random-string"  # used to hash visitor IPs before storing

# --- OTP ---
OTP_HASH_SECRET="replace-with-a-long-random-string"  # peppers OTP codes before hashing

# --- Email OTP (SES / SendGrid) ---
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="no-reply@yourapp.com"

# --- Phone OTP (Twilio / MSG91) ---
SMS_PROVIDER_ACCOUNT_SID=""
SMS_PROVIDER_AUTH_TOKEN=""
SMS_FROM_NUMBER=""

# --- File Storage (S3 / R2) ---
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- OCR Provider ---
GOOGLE_CLOUD_VISION_API_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""  # path to service-account JSON (used by apps/worker)
# or
AWS_TEXTRACT_ACCESS_KEY_ID=""
AWS_TEXTRACT_SECRET_ACCESS_KEY=""

# --- Queue (Redis) ---
REDIS_URL="redis://localhost:6379"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"