# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/medread"

# --- File Storage (S3 / R2) ---
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- OCR Provider ---
GOOGLE_CLOUD_VISION_API_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""  # path to service-account JSON (used by apps/worker)
# --- Queue (Redis) ---
REDIS_URL="redis://localhost:6379"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Privacy ---
# Public uploads are deleted after this many hours.
PRESCRIPTION_RETENTION_HOURS="24"
# Salt used only to hash IP addresses for abuse protection.
IP_HASH_SALT="replace-with-a-long-random-string"
