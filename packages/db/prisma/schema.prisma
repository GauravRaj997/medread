generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrescriptionStatus {
  UPLOADED
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
  FAILED
  REJECTED     // not a prescription at all — blank page, random text, etc.
}

// Every prescription is unowned — apps/web has no accounts. expiresAt
// applies to every row; the worker's cleanup job purges past it.
model Prescription {
  id              String              @id @default(cuid())

  originalFileUrl String
  fileHash        String
  status          PrescriptionStatus  @default(UPLOADED)

  patientName      String?
  doctorName       String?
  doctorRegNo      String?
  clinicName       String?
  diagnosis        String?
  prescriptionDate DateTime?
  rawOcrText       String?            @db.Text
  confidenceScore  Float?

  medicines        Medicine[]

  exportedPdfUrl   String?
  exportedJpegUrl  String?

  // Abuse/quality monitoring — what the admin review queue is for.
  flaggedForReview Boolean @default(false)
  flagReason       String? // e.g. "BLANK_PAGE", "GIBBERISH_TEXT", "NOT_A_PRESCRIPTION", "LOW_CONFIDENCE"
  reviewedByAdmin  Boolean @default(false)

  expiresAt        DateTime

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([fileHash])
  @@index([expiresAt])
  @@index([flaggedForReview])
}

model Medicine {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  rawText        String
  matchedName    String?
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  confidence     Float?

  @@index([prescriptionId])
}

// Backs apps/web/lib/uploadRateLimit.ts — simple per-IP throttling on uploads.
model UploadRateEvent {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// Separate throttle table for the contact form, so it doesn't share a
// counter with upload rate limiting — a legitimate user could need to do
// both in the same session without one blocking the other.
model ContactRateEvent {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

model AdminLoginEvent {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// The public contact/support form (apps/web) writes here.
// apps/admin reads/resolves them. No user relation — the sender isn't an
// account, just whatever contact info they typed in.
model ContactMessage {
  id          String   @id @default(cuid())
  name        String?
  email       String
  subject     String?
  message     String   @db.Text

  resolved    Boolean  @default(false)
  adminNote   String?  // free-text note the admin leaves after reading/resolving

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([resolved])
  @@index([createdAt])
}

// Lightweight action log for the single admin — no User relation needed
// since there's no User table anymore. Just records what happened.
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // e.g. "REVIEWED_UPLOAD", "RESOLVED_CONTACT_MESSAGE"
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action])
}
